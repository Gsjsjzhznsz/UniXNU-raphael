+// Board diagnostic only: observe original fairplay IOKit results.
+// No additional matching, iterator advancement, client opening, or reply occurs.
+static void
+raphael_fairplay_iokit_trace(const char *phase, OSDictionary *matching,
+    kern_return_t status, OSObject *object, uint32_t type = 0)
+{
+    char name[32] = {};
+    proc_selfname(name, sizeof(name));
+    if (strncmp(name, "fairplay", 8)) return;
+    OSString *provider = matching ? OSDynamicCast(OSString, matching->getObject("IOProviderClass")) : NULL;
+    OSString *nameMatch = matching ? OSDynamicCast(OSString, matching->getObject("IONameMatch")) : NULL;
+    printf("RPH FAIRPLAY IOKIT pid=%d phase=%s status=%x provider=%s name=%s class=%s type=%u\n",
+        proc_selfpid(), phase, (unsigned)status,
+        provider ? provider->getCStringNoCopy() : "<none>",
+        nameMatch ? nameMatch->getCStringNoCopy() : "<none>",
+        object ? object->getMetaClass()->getClassName() : "<none>", type);
+}
