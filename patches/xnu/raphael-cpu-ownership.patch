--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -7834,6 +7834,20 @@
 	uint32_t            done;
 
 	assert( table );
+	/* This port's explicit boot-CPU contract belongs to RaphaelBootCpu.
+	 * The imported AppleARMCPU expects Apple CPU resources and must not
+	 * probe the independently described CPU before its native owner starts.
+	 * No other CPU nubs or imported driver classes change their matching.
+	 */
+	OSString *candidateClass = OSDynamicCast(OSString, table->getObject(gIOClassKey));
+	OSData *nativeCpu = OSDynamicCast(OSData, getProperty("unixnu,boot-cpu"));
+	uint32_t nativeCpuVersion = 0;
+	if (nativeCpu && nativeCpu->getLength() == sizeof(nativeCpuVersion)) {
+		memcpy(&nativeCpuVersion, nativeCpu->getBytesNoCopy(), sizeof(nativeCpuVersion));
+	}
+	if (nativeCpuVersion == 1 && candidateClass && candidateClass->isEqualTo("AppleARMCPU")) {
+		return false;
+	}
 
 #if defined(XNU_TARGET_OS_OSX)
 	OSArray* aliasServiceRegIds = NULL;
