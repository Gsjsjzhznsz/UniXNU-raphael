+/* Explicit bounded root observer. It never substitutes for BSD root mounting. */
+volatile uint64_t raphael_native_root_record[16];
+volatile uint32_t raphael_native_root_stage;
+void raphael_native_root_observer(void *parameter, wait_result_t result)
+{
+	(void)parameter; (void)result;
+	extern void raphael_native_storage_quiesce(void);
+	extern void raphael_native_root_checkpoint(void);
+	raphael_native_root_record[0] = 0x31544f4f52485052ULL;
+	raphael_native_root_record[1] = 1;
+	raphael_native_root_record[7] = 50;
+	for (unsigned i = 0; i < 50; ++i) {
+		IOSleep(100);
+		raphael_native_root_record[2] = i + 1;
+#if defined(XNU_OWNER_ROOT_AUDIT) && XNU_OWNER_ROOT_AUDIT
+		extern volatile int native_owner_root_accepted;
+		if (native_owner_root_accepted == 1) {
+			raphael_native_root_record[3] = 1;
+			break;
+		}
+#endif
+	}
+	if (raphael_native_root_record[3] && rootvnode) {
+		mount_t mounted = vnode_mount(rootvnode);
+		struct vfsstatfs *status = vfs_statfs(mounted);
+		raphael_native_root_record[4] = (uintptr_t)rootvnode;
+		raphael_native_root_record[5] = vfs_flags(mounted);
+		raphael_native_root_record[6] = rootdev;
+		char *type = (char *)&raphael_native_root_record[8];
+		for (unsigned i = 0; i < sizeof(status->f_fstypename) && i < 31 && status->f_fstypename[i]; ++i) type[i] = status->f_fstypename[i];
+		char *device = (char *)&raphael_native_root_record[12];
+		for (unsigned i = 0; i < 31 && rootdevice[i]; ++i) device[i] = rootdevice[i];
+	}
+	raphael_native_root_record[1] = 2;
+	raphael_native_storage_quiesce();
+	__asm__ volatile("msr daifset, #0xf" ::: "memory");
+	raphael_native_root_checkpoint();
+	panic("Raphael root observer returned");
+}
